# Raw footage and renders. These are large, regenerable, and belong on the
# machine that has the camera -- not in the history.
videos/
projects/
previews/
broll/out/
broll/public/video/
broll/public/transcripts/
broll/public/overlay-assets/
broll/public/slides/
broll/props.generated.json
broll/props.verify.json

# Rendered carousels. The images and the words are committed; the stills are
# whatever `python pipeline/slides.py` last made of them.
# Two levels deep, not one: a story can live at stories/<set>/<slide>/, and
# `stories/*/out/` matched only the shallow case. The nested renders were
# tracked, both sides edited them, and git cannot merge a PNG.
stories/**/out/

# ...except the format samples. One render of each format, committed on
# purpose: they are a catalogue to look at, like the references themselves,
# and nobody should have to run a render to see what a format looks like.
!stories/formats/out/

# Reference reels are NOT ignored: reference/ and howtocutvideo/ are meant to
# be committed, since analysing them is a job for the session, which only sees
# what the repository carries.

.venv-check/
node_modules/
__pycache__/
.pytest_cache/
*.pyc
